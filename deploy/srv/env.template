# /srv/Siriopsis/.env 의 견본. deploy/host/install.sh 가 처음 한 번 이것으로 만든다.
# **그 뒤로는 통째로 덮어쓰지 않는다** — 판을 올릴 때는 IMAGE_TAG 한 줄만 고친다(.guides/web/deployment.md §5).

IMAGE_TAG=v0.1.0

# install.sh 가 채운다. 평문으로 devlog·문서에 옮기지 않는다
SIRIOPSIS_SECRET_KEY=
SIRIOPSIS_DEBUG=0

# nginx 가 /Siriopsis/ 를 떼고 넘긴다. Django 는 링크를 만들 때만 이것을 앞에 붙인다
SIRIOPSIS_SCRIPT_NAME=/Siriopsis

SIRIOPSIS_DB=/srv/Siriopsis/db/Siriopsis.db
SIRIOPSIS_SOURCE_ROOT=/nfs/temp-share/Sirius Passet Catalog
SIRIOPSIS_THUMB_CACHE=/data/Siriopsis/thumbcache
