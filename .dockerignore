# 빌드 컨텍스트에서 뺄 것. docker 는 .gitignore 를 보지 않는다.
# 자료·DB 는 이미지에 굽지 않는다 — 전부 마운트해서 본다.

.git/
.gitignore
__pycache__/
*.pyc
.venv/

# DB 와 백업 — 이미지에 구우면 사본이 갈라진다
Siriopsis.db
Siriopsis.db-wal
Siriopsis.db-shm
backup/

# 장비별 설정. 이미지에 구우면 데이터 경로와 비밀키가 이미지에 박힌다
.env

# 문서. 이미지에 넣을 이유가 없다
docs/
devlog/

# 컨테이너 안에서는 ../kopri-devdocs 가 없어 끊어진 링크가 된다
.guides
thumbcache/
