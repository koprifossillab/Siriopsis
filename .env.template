# 장비마다 다른 값. `.env` 로 복사해서 채운다 (`.env` 는 gitignore).
#
# 컨테이너는 compose 가 환경변수를 직접 주므로 이 파일이 필요 없다.
# 이 파일은 **호스트에서 manage.py·스크립트를 그냥 돌릴 때**를 위한 것이다.

# DB 위치. 운영은 /srv/Siriopsis/db/Siriopsis.db 다 — **개발에서 그쪽을 가리키지 않는다.**
# 비우면 저장소 뿌리의 Siriopsis.db(gitignore)를 쓴다.
#SIRIOPSIS_DB=

# 큰 자료가 생기면 루트 SSD 가 아니라 /data 쪽 큰 디스크에 둔다 (.guides/web/operations.md §6).
#SIRIOPSIS_DATA_ROOT=

# 백업 사본. 큰 디스크에 둔다.
#SIRIOPSIS_BACKUP_DIR=

# 이 이름/주소로도 열 때 추가한다 (settings.py 의 ALLOWED_HOSTS 에 더해진다).
#SIRIOPSIS_HOSTS=

# 운영으로 돌릴 때 반드시 채운다.
#SIRIOPSIS_SECRET_KEY=
#SIRIOPSIS_DEBUG=0

# 서브경로 아래에 얹을 때 (운영은 /Siriopsis). 비우면 뿌리(/)에 붙는다.
#SIRIOPSIS_SCRIPT_NAME=

# 가장 새 백업이 이보다 오래되면 /healthz 가 degraded. **cron 이 없는 장비에서는 켜지 않는다.**
#SIRIOPSIS_BACKUP_MAX_AGE_H=

# NAS 원본 자료의 뿌리(읽기만). 비우면 /nfs/temp-share/Sirius Passet Catalog
#SIRIOPSIS_SOURCE_ROOT=

# 분류 정보를 읽어 올 phyloserver siriuspasset. 비우면 http://172.16.116.98/siriuspasset/
#SIRIOPSIS_CATALOG_URL=
# 화면에서 phyloserver 로 가는 링크(사람의 PC 에서 열린다). 비우면 http://paleolab/siriuspasset/
#SIRIOPSIS_CATALOG_LINK_URL=

# 컷 축소본 캐시. 비우면 <DATA_ROOT>/thumbcache. 지워도 다시 만든다
#SIRIOPSIS_THUMB_CACHE=
